---
import { categories } from "../lib/categories";
import { localizeRecord, localizeTool, localePath, t, type Locale } from "../lib/i18n";
import { toolIcon } from "../lib/toolIcons";
import type { ToolDefinition } from "../lib/types";

type Props = {
  tool: ToolDefinition;
  locale?: Locale;
};

const { tool: sourceTool, locale = "en" } = Astro.props;
const tool = localizeTool(sourceTool, locale);
const category = localizeRecord(categories[tool.category], locale);
---

<article class="tool-card">
  <div class="tool-card-top">
    <span class="tool-icon" aria-hidden="true">{toolIcon(tool.slug)}</span>
    <span class="tool-tag">{category.deck}</span>
  </div>
  <h3><a href={localePath(locale, `/${tool.slug}/`)}>{tool.title}</a></h3>
  <p>{tool.description}</p>
  <a class="card-link" href={localePath(locale, `/${tool.slug}/`)}>{t(locale, "Open calculator")}</a>
</article>
